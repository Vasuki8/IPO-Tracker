{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vasuki8.github.io/IPO-Tracker/data/ipo-schema.json",
  "title": "IPO Tracker published dataset",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "records"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collection_started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ipoRecord"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sourceStatus": {
      "type": "string",
      "enum": [
        "verified",
        "provisional",
        "conflict",
        "missing"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "url",
        "document_type",
        "document_identity",
        "publication_date",
        "page",
        "collected_at"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "page": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": [
        "value",
        "status",
        "evidence",
        "corrections"
      ],
      "properties": {
        "value": {},
        "status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correction"
          }
        }
      },
      "additionalProperties": false
    },
    "ipoRecord": {
      "type": "object",
      "required": [
        "id",
        "issuer_name",
        "board",
        "board_evidence",
        "sector",
        "status",
        "status_evidence",
        "price_band",
        "issue_price",
        "issue_size_inr",
        "market_lot",
        "minimum_bid_quantity",
        "minimum_application_amount_inr",
        "application_requirements",
        "open_date",
        "close_date",
        "listing_date",
        "documents",
        "first_observed_at",
        "last_collected_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "issuer_name": {
          "type": "string",
          "minLength": 1
        },
        "board": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Mainboard",
            "SME",
            null
          ]
        },
        "board_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "sector": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "open",
            "upcoming",
            "closed",
            "listed",
            "withdrawn",
            null
          ]
        },
        "status_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "price_band": {
          "$ref": "#/$defs/priceBandField"
        },
        "issue_price": {
          "$ref": "#/$defs/positiveNumberField"
        },
        "issue_size_inr": {
          "$ref": "#/$defs/positiveNumberField"
        },
        "market_lot": {
          "$ref": "#/$defs/shareQuantityField"
        },
        "minimum_bid_quantity": {
          "$ref": "#/$defs/shareQuantityField"
        },
        "minimum_application_amount_inr": {
          "$ref": "#/$defs/positiveNumberField",
          "description": "Legacy generic minimum application amount. Do not populate this field from investor-category-specific evidence."
        },
        "open_date": {
          "$ref": "#/$defs/dateField"
        },
        "close_date": {
          "$ref": "#/$defs/dateField"
        },
        "listing_date": {
          "$ref": "#/$defs/dateField"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "identity",
              "url",
              "publication_date",
              "collected_at"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "identity": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publication_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "collected_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        },
        "first_observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "last_collected_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "application_requirements": {
          "$ref": "#/$defs/applicationRequirements",
          "description": "Investor-category-specific application requirements. Monetary amount and share quantity remain separate evidence-bearing fields."
        }
      },
      "additionalProperties": false
    },
    "applicationRequirementCategory": {
      "type": "object",
      "required": [
        "minimum_application_amount_inr",
        "minimum_bid_quantity"
      ],
      "properties": {
        "minimum_application_amount_inr": {
          "$ref": "#/$defs/positiveNumberField"
        },
        "minimum_bid_quantity": {
          "$ref": "#/$defs/shareQuantityField"
        }
      },
      "additionalProperties": false
    },
    "applicationRequirements": {
      "type": "object",
      "required": [
        "retail",
        "non_institutional",
        "anchor_investor"
      ],
      "properties": {
        "retail": {
          "$ref": "#/$defs/applicationRequirementCategory"
        },
        "non_institutional": {
          "$ref": "#/$defs/applicationRequirementCategory"
        },
        "anchor_investor": {
          "$ref": "#/$defs/applicationRequirementCategory"
        }
      },
      "additionalProperties": false
    },
    "standardCorrection": {
      "type": "object",
      "required": [
        "recorded_at",
        "previous_value",
        "new_value",
        "reason"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_value": {},
        "new_value": {},
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "retainedCorrection": {
      "type": "object",
      "required": [
        "corrected_at",
        "previous_value"
      ],
      "properties": {
        "corrected_at": {
          "type": "string",
          "format": "date-time"
        },
        "previous_value": {},
        "previous_source_value": {},
        "previous_status": {
          "$ref": "#/$defs/sourceStatus"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replacement_value": {},
        "previous_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "reason",
            "previous_evidence"
          ]
        },
        {
          "required": [
            "replacement_value",
            "evidence"
          ]
        }
      ],
      "additionalProperties": false
    },
    "sourceConflict": {
      "type": "object",
      "required": [
        "kind",
        "status",
        "note"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "unresolved"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          }
        },
        "competing": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          }
        },
        "preferred_candidate": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          }
        },
        "previous_observation": {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "value": {}
          }
        },
        "competing_observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {}
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "candidate",
            "competing"
          ]
        },
        {
          "required": [
            "preferred_candidate",
            "previous_observation"
          ]
        },
        {
          "required": [
            "preferred_candidate",
            "competing_observations"
          ]
        }
      ],
      "additionalProperties": false
    },
    "correction": {
      "description": "Preserves the standard correction contract, legacy evidence-bearing replacement histories, and unresolved official-source conflicts without discarding their provenance.",
      "anyOf": [
        {
          "$ref": "#/$defs/standardCorrection"
        },
        {
          "$ref": "#/$defs/retainedCorrection"
        },
        {
          "$ref": "#/$defs/sourceConflict"
        }
      ]
    },
    "positiveNumberField": {
      "$ref": "#/$defs/field",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "shareQuantityField": {
      "$ref": "#/$defs/field",
      "properties": {
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "dateField": {
      "$ref": "#/$defs/field",
      "properties": {
        "value": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "priceBandField": {
      "$ref": "#/$defs/field",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "max": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    }
  }
}
